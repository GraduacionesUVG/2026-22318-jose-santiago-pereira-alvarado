# Variables de entorno del proyecto AR Tour Kaminaljuyu (iOS)
#
# En un proyecto iOS nativo, estas variables NO se leen desde un archivo .env,
# sino desde Secrets.xcconfig (ver Secrets.xcconfig.example en esta misma
# carpeta). Este archivo sirve como referencia de las variables que el
# proyecto necesita en tiempo de compilacion.
#
# Para configurarlas:
#   1. Copiar Secrets.xcconfig.example como Secrets.xcconfig
#   2. Reemplazar los placeholders con los valores reales

# Google Maps SDK para iOS - API Key
# Obten una en: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
